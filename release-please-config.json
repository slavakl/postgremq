{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "bootstrap-sha": "c398691f4cb58a8e37e73a20ca53d748370d400f",
  "separate-pull-requests": true,
  "always-update": true,
  "include-component-in-tag": true,
  "include-v-in-tag": true,
  "tag-separator": "/",
  "bump-minor-pre-major": true,
  "bump-patch-for-minor-pre-major": false,
  "changelog-sections": [
    {
      "type": "feat",
      "section": "Features"
    },
    {
      "type": "fix",
      "section": "Bug Fixes"
    },
    {
      "type": "perf",
      "section": "Performance Improvements"
    },
    {
      "type": "revert",
      "section": "Reverts"
    },
    {
      "type": "deps",
      "section": "Dependencies"
    },
    {
      "type": "docs",
      "section": "Documentation",
      "hidden": true
    },
    {
      "type": "refactor",
      "section": "Code Refactoring",
      "hidden": true
    },
    {
      "type": "test",
      "section": "Tests",
      "hidden": true
    },
    {
      "type": "build",
      "section": "Build System",
      "hidden": true
    },
    {
      "type": "ci",
      "section": "Continuous Integration",
      "hidden": true
    },
    {
      "type": "chore",
      "section": "Miscellaneous Chores",
      "hidden": true
    }
  ],
  "packages": {
    "mq": {
      "component": "mq",
      "release-type": "simple",
      "version-file": "VERSION",
      "package-name": "mq",
      "release-as": "0.2.0-e2e.1"
    },
    "postgremq-go": {
      "component": "postgremq-go",
      "release-type": "go",
      "package-name": "postgremq.dev/postgremq-go",
      "exclude-paths": [
        "postgremq-go/examples"
      ],
      "release-as": "0.2.0-e2e.1"
    },
    "cmd/postgremq": {
      "component": "cmd/postgremq",
      "release-type": "go",
      "package-name": "postgremq.dev/cmd/postgremq",
      "release-as": "0.2.0-e2e.1"
    },
    "postgremq-rs": {
      "component": "rust",
      "release-type": "rust",
      "package-name": "postgremq",
      "release-as": "0.2.0-e2e.1"
    },
    "postgremq-ts": {
      "component": "npm",
      "release-type": "node",
      "package-name": "postgremq",
      "release-as": "0.2.0-e2e.1"
    }
  },
  "prerelease": true
}
